{
  "name": "jamilih",
  "version": "0.68.1",
  "type": "module",
  "author": {
    "name": "Brett Zamir",
    "email": "brettz9@yahoo.com",
    "url": "http://brett-zamir.me"
  },
  "contributors": [],
  "scripts": {
    "tsc": "tsc",
    "attw": "attw --pack",
    "amo": "echo \"Bundling for AMO\" && tar -czf compressed-source/source.tar.gz src plugins .babelrc.json package.json README.md rollup.config.js",
    "prepublishOnly": "npm run build",
    "license-badge": "license-badger --corrections --uncategorizedLicenseTemplate \"\\${license} (\\${name} (\\${version}))\" --filteredTypes=nonempty --textTemplate \"License types\n(project, deps, and bundled devDeps)\" --packageJson --production badges/licenses-badge.svg",
    "license-badge-dev": "license-badger --corrections --filteredTypes=nonempty --textTemplate \"License types\n(all devDeps)\" --allDevelopment badges/licenses-badge-dev.svg",
    "license-badges": "npm run license-badge && npm run license-badge-dev",
    "lint": "npm run eslint --",
    "eslint": "eslint .",
    "rollup": "rollup -c",
    "build": "rm -Rf dist && mkdir dist && echo '{\"type\": \"commonjs\"}' > dist/package.json && npm run rollup && tsc -p tsconfig-build.json && npm run copy-dts",
    "copy-dts": "cp dist/src/jml.d.ts dist/src/jml.d.mts && cp dist/src/jml-jsdom.d.ts dist/src/jml-jsdom.d.mts && cp dist/plugins/getInterpolator.d.ts dist/plugins/getInterpolator.d.mts",
    "browser-test": "npm run build && open-cli http://localhost:8091/test/ && npm run start",
    "mocha": "mocha --require test-helpers/loadTests.js test/test.*.js --reporter-options configFile=mocha-multi-reporters.json",
    "c8": "rm -Rf .nyc_output && rm -Rf coverage && rm -Rf node_modules/.cache && c8 npm run mocha && npm run coverage-badge",
    "test": "npm run eslint && npm run build && npm run c8",
    "kill-http-server": "pkill -f \".bin/http-server -p\"",
    "build-docs": "rm -rf docs/jsdoc/*;jsdoc --pedantic -c docs/jsdoc-config.js .",
    "open-docs": "open-cli http://localhost:8091/docs/jsdoc/ && npm start",
    "coverage-badge": "coveradge badges/coverage-badge.svg",
    "coverage": "open-cli http://localhost:8091/coverage/ && npm start",
    "test-no-open": "npm run kill-http-server ; npm run eslint && npm run build && npm run start",
    "start": "http-server -p 8091",
    "watch": "chokidar '**/*.js' -c 'npm run test-no-open' -i 'dist' -i 'node_modules' & npm run test-no-open"
  },
  "c8": {
    "exclude": [
      "test",
      "test-helpers",
      ".mocharc.js"
    ],
    "reporter": [
      "text",
      "html",
      "json-summary"
    ]
  },
  "browserslist": [
    "defaults, not op_mini all"
  ],
  "description": "Provide round-trippable JSON/JavaScript serialization",
  "types": "./dist/src/jml.d.ts",
  "main": "dist/jml-jsdom.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/src/jml.d.ts",
        "default": "./dist/jml.js"
      },
      "import": {
        "types": "./dist/src/jml-jsdom.d.mts",
        "default": "./dist/jml-jsdom.mjs"
      },
      "require": {
        "types": "./dist/src/jml-jsdom.d.ts",
        "default": "./dist/jml-jsdom.js"
      }
    },
    "./dist/jml.js": {
      "import": {
        "types": "./dist/src/jml.d.mts",
        "default": "./dist/jml.mjs"
      },
      "require": {
        "types": "./dist/src/jml.d.ts",
        "default": "./dist/jml.js"
      }
    },
    "./dist/jml-noinnerh.js": {
      "import": {
        "types": "./dist/src/jml.d.mts",
        "default": "./dist/jml-noinnerh.mjs"
      },
      "require": {
        "types": "./dist/src/jml.d.ts",
        "default": "./dist/jml-noinnerh.js"
      }
    },
    "./dist/jml-noinnerh.mjs": {
      "import": {
        "types": "./dist/src/jml.d.mts",
        "default": "./dist/jml-noinnerh.mjs"
      },
      "require": {
        "types": "./dist/src/jml.d.ts",
        "default": "./dist/jml-noinnerh.js"
      }
    },
    "./dist/getInterpolator.js": {
      "import": {
        "types": "./dist/plugins/getInterpolator.d.mts",
        "default": "./dist/getInterpolator.mjs"
      },
      "require": {
        "types": "./dist/plugins/getInterpolator.d.ts",
        "default": "./dist/getInterpolator.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brettz9/jamilih"
  },
  "homepage": "https://github.com/brettz9/jamilih",
  "typesVersions": {
    "*": {
      "dist/getInterpolator.js": [
        "dist/plugins/getInterpolator.d.ts"
      ],
      "dist/jml.js": [
        "dist/src/jml.d.ts"
      ],
      "dist/jml-noinnerh.js": [
        "dist/src/jml.d.ts"
      ],
      "dist/jml-noinnerh.mjs": [
        "dist/src/jml.d.mts"
      ]
    }
  },
  "keywords": [
    "json",
    "javascript",
    "template",
    "templating",
    "html"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/jamilih/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "babel-plugin-add-module-exports": "^1.0.4",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chokidar-cli": "^3.0.0",
    "coveradge": "^0.8.2",
    "eslint": "^10.8.1",
    "eslint-config-ash-nazg": "^42.5.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.5",
    "jsdom": "30.0.1",
    "license-badger": "^0.23.0",
    "mocha": "^11.8.0",
    "mocha-badge-generator": "^0.11.0",
    "mocha-multi-reporters": "^1.5.1",
    "open-cli": "^9.0.0",
    "rollup": "4.62.4",
    "rollup-plugin-re": "^1.0.7",
    "typescript": "^7.0.2"
  }
}
